    {
        "id": "ceecfcefb73946cb",
        "type": "function",
        "z": "df9f0f5e099aca5e",
        "name": "function 2",
        "func": "let initialized = flow.get('ledInitialized') || { V: false, I: false, T: false };\nlet outputs = [null, null, null];\n\nif (msg.payload.V !== undefined) {\n    outputs[0] = { payload: msg.payload.V };\n    initialized.V = true;\n} else if (!initialized.V) {\n    outputs[0] = { payload: \"IN\" };  // nigdy nie bylo danych -- zakladamy normalny stan startowy\n    initialized.V = true;\n}\n\nif (msg.payload.I !== undefined) {\n    outputs[1] = { payload: msg.payload.I };\n    initialized.I = true;\n} else if (!initialized.I) {\n    outputs[1] = { payload: \"IN\" };\n    initialized.I = true;\n}\n\nif (msg.payload.T !== undefined) {\n    outputs[2] = { payload: msg.payload.T };\n    initialized.T = true;\n} else if (!initialized.T) {\n    outputs[2] = { payload: \"IN\" };\n    initialized.T = true;\n}\n\nflow.set('ledInitialized', initialized);\nreturn outputs;",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
