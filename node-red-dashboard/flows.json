    {
        "id": "bdbde58ceb33bf45",
        "type": "function",
        "z": "df9f0f5e099aca5e",
        "name": "function 1",
        "func": "\nlet parts = [];\n\nif (msg.payload.SPI === 'COMMUNICATION') parts.push('SPI communication fault!');\nelse if (msg.payload.SPI === 'STORAGE') parts.push('SPI storage fault!');\n\nif (msg.payload.S === 'MEASUREMENT') parts.push('Measurement out of range!');\nelse if (msg.payload.S === 'COMMUNICATION') parts.push('Modbus communication lost!');\n\nmsg.payload = parts.length > 0 ? ('Alarm: ' + parts.join(' + ')) : 'All systems normal.';\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 400,
